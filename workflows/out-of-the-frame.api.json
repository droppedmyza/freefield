  "grip_prompt": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "Image 1 shows an oil painting in a gold frame on a museum wall. Image 2 is a photo of the person in the painting. Edit only the inside of the painting in image 1: the painted person has come alive, turns to the viewer with a warm smile and leans forward, and both of their painted hands now rest flat on the bottom of the canvas, inside the picture, just above the inner edge of the gold frame, their arms coming from their own shoulders. They are still an oil painting with visible brushstrokes, wearing exactly the same clothes as in image 1: the ochre jacket with the white collar, the blue and yellow turban and the pearl earring. The gold frame and the green wall are untouched. Take only the face from image 2, not its clothes or pose.",
      "clip": [
        "klein_te",
        0
      ]
    },
    "_meta": {
      "title": "3. GRIP: Keyframe prompt (what the still should show)"
    }
