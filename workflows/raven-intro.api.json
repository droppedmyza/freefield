{
  "photo": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "your_photo.png"
    },
    "_meta": {
      "title": "Your photo (preset input)"
    }
  },
  "start": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "photo",
        0
      ],
      "upscale_method": "lanczos",
      "width": 720,
      "height": 1280,
      "crop": "center"
    },
    "_meta": {
      "title": "Your photo, vertical (kept as it is)"
    }
  },
  "wan_model": {
    "class_type": "UnetLoaderGGUF",
    "inputs": {
      "unet_name": "Wan2_2-TI2V-5B-Turbo-Q6_K.gguf"
    },
    "_meta": {
      "title": "Wan 2.2 TI2V-5B Turbo Q6 (Apache-2.0)"
    }
  },
  "wan_te": {
    "class_type": "CLIPLoaderGGUF",
    "inputs": {
      "clip_name": "umt5-xxl-encoder-Q5_K_M.gguf",
      "type": "wan"
    },
    "_meta": {
      "title": "umt5-xxl text encoder (GGUF)"
    }
  },
  "wan_vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "wan2.2_vae.safetensors"
    },
    "_meta": {
      "title": "Wan 2.2 VAE"
    }
  },
  "motion_prompt": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "In a sudden burst it becomes a flock of black ravens that fly up and out of the frame, and only the empty shelf remains. Smooth, natural motion. Static shot: the camera holds steady and the background stays still.",
      "clip": [
        "wan_te",
        0
      ]
    },
    "_meta": {
      "title": "Motion prompt (what happens in the clip)"
    }
  },
  "motion_negative": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": [
        "motion_prompt",
        0
      ]
    },
    "_meta": {
      "title": "Empty negative (CFG 1)"
    }
  },
  "video_latent": {
    "class_type": "Wan22ImageToVideoLatent",
    "inputs": {
      "vae": [
        "wan_vae",
        0
      ],
      "width": 480,
      "height": 832,
      "length": 73,
      "batch_size": 1,
      "start_image": [
        "start",
        0
      ]
    },
    "_meta": {
      "title": "Start the clip from the keyframe"
    }
  },
  "wan_shift": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": [
        "wan_model",
        0
      ],
      "shift": 8.0
    },
    "_meta": {
      "title": "Sampling shift"
    }
  },
  "video_sample": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "wan_shift",
        0
      ],
      "seed": 21,
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": [
        "motion_prompt",
        0
      ],
      "negative": [
        "motion_negative",
        0
      ],
      "latent_image": [
        "video_latent",
        0
      ],
      "denoise": 1.0
    },
    "_meta": {
      "title": "Animate (4 steps)"
    }
  },
  "video_frames": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "video_sample",
        0
      ],
      "vae": [
        "wan_vae",
        0
      ]
    },
    "_meta": {
      "title": "Decode frames"
    }
  },
  "watermark": {
    "class_type": "TextOverlay",
    "inputs": {
      "images": [
        "video_frames",
        0
      ],
      "text": "FreeField \u00b7 open source",
      "font_size": 2.5,
      "color": "#ffffff",
      "position": "top",
      "align": "right",
      "outline": true
    },
    "_meta": {
      "title": "Watermark (made with FreeField)"
    }
  },
  "video": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "watermark",
        0
      ],
      "fps": 24.0
    },
    "_meta": {
      "title": "Frames to video"
    }
  },
  "clip_save": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "video",
        0
      ],
      "filename_prefix": "freefield/clip",
      "format": "mp4",
      "format.codec": "h264"
    },
    "_meta": {
      "title": "Save clip (the result)"
    }
  }
}
