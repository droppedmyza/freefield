{
  "photo": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "your_photo.png"
    },
    "_meta": {
      "title": "Your photo (preset input)"
    }
  },
  "artwork_ref": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "your_photo.png"
    },
    "_meta": {
      "title": "Artwork with the face blanked (keyframe reference)"
    }
  },
  "plate": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "plate.png"
    },
    "_meta": {
      "title": "Gallery wall with an empty frame (preset asset)"
    }
  },
  "plate_hole": {
    "class_type": "LoadImageMask",
    "inputs": {
      "image": "plate_hole.png",
      "channel": "red"
    },
    "_meta": {
      "title": "Frame opening mask, cropped to the opening (preset asset)"
    }
  },
  "wall": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "wall_mask.png"
    },
    "_meta": {
      "title": "Lock mask: white = wall (and, for Out of the Frame, the gilt) the model may not touch (preset asset, make_plate.py)"
    }
  },
  "wall_mask": {
    "class_type": "ImageToMask",
    "inputs": {
      "image": [
        "wall",
        0
      ],
      "channel": "red"
    },
    "_meta": {
      "title": "Wall mask"
    }
  },
  "frame_zone": {
    "class_type": "InvertMask",
    "inputs": {
      "mask": [
        "wall_mask",
        0
      ]
    },
    "_meta": {
      "title": "Frame zone (opening, frame, rail)"
    }
  },
  "klein_model": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "flux-2-klein-4b-fp8.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "FLUX.2 klein 4B (Apache-2.0)"
    }
  },
  "klein_te": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen_3_4b_fp8_mixed.safetensors",
      "type": "flux2",
      "device": "default"
    },
    "_meta": {
      "title": "Qwen3-4B text encoder"
    }
  },
  "klein_vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "flux2-vae.safetensors"
    },
    "_meta": {
      "title": "FLUX.2 VAE"
    }
  },
  "painting_prompt": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "Image 1 is a photo of a person. Make a product photo of a collectible plastic action figure of this exact person: standing, full body from head to knees, facing the viewer with a confident smile, the same face, hairstyle, skin tone and outfit as image 1, with a slightly glossy molded-plastic finish. Plain solid royal-blue backing card behind the figure, flat even light. The face is large and clearly visible.",
      "clip": [
        "klein_te",
        0
      ]
    },
    "_meta": {
      "title": "1a. Costume photo: Keyframe prompt (what the still should show)"
    }
  },
  "painting_negative": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": [
        "painting_prompt",
        0
      ]
    },
    "_meta": {
      "title": "1a. Costume photo: Empty negative (CFG 1)"
    }
  },
  "painting_photo_scaled": {
    "class_type": "ImageScaleToTotalPixels",
    "inputs": {
      "image": [
        "photo",
        0
      ],
      "upscale_method": "lanczos",
      "megapixels": 1.0,
      "resolution_steps": 16
    },
    "_meta": {
      "title": "1a. Costume photo: Reference 1: scale to ~1MP"
    }
  },
  "painting_photo_latent": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": [
        "painting_photo_scaled",
        0
      ],
      "vae": [
        "klein_vae",
        0
      ]
    },
    "_meta": {
      "title": "1a. Costume photo: Reference 1: encode"
    }
  },
  "painting_photo_ref_pos": {
    "class_type": "ReferenceLatent",
    "inputs": {
      "conditioning": [
        "painting_prompt",
        0
      ],
      "latent": [
        "painting_photo_latent",
        0
      ]
    },
    "_meta": {
      "title": "1a. Costume photo: Attach reference 1 (positive)"
    }
  },
  "painting_photo_ref_neg": {
    "class_type": "ReferenceLatent",
    "inputs": {
      "conditioning": [
        "painting_negative",
        0
      ],
      "latent": [
        "painting_photo_latent",
        0
      ]
    },
    "_meta": {
      "title": "1a. Costume photo: Attach reference 1 (negative)"
    }
  },
  "painting_artwork_ref_scaled": {
    "class_type": "ImageScaleToTotalPixels",
    "inputs": {
      "image": [
        "artwork_ref",
        0
      ],
      "upscale_method": "lanczos",
      "megapixels": 1.0,
      "resolution_steps": 16
    },
    "_meta": {
      "title": "1a. Costume photo: Reference 2: scale to ~1MP"
    }
  },
  "painting_artwork_ref_latent": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": [
        "painting_artwork_ref_scaled",
        0
      ],
      "vae": [
        "klein_vae",
        0
      ]
    },
    "_meta": {
      "title": "1a. Costume photo: Reference 2: encode"
    }
  },
  "painting_artwork_ref_ref_pos": {
    "class_type": "ReferenceLatent",
    "inputs": {
      "conditioning": [
        "painting_photo_ref_pos",
        0
      ],
      "latent": [
        "painting_artwork_ref_latent",
        0
      ]
    },
    "_meta": {
      "title": "1a. Costume photo: Attach reference 2 (positive)"
    }
  },
  "painting_artwork_ref_ref_neg": {
    "class_type": "ReferenceLatent",
    "inputs": {
      "conditioning": [
        "painting_photo_ref_neg",
        0
      ],
      "latent": [
        "painting_artwork_ref_latent",
        0
      ]
    },
    "_meta": {
      "title": "1a. Costume photo: Attach reference 2 (negative)"
    }
  },
  "painting_guider": {
    "class_type": "CFGGuider",
    "inputs": {
      "model": [
        "klein_model",
        0
      ],
      "positive": [
        "painting_artwork_ref_ref_pos",
        0
      ],
      "negative": [
        "painting_artwork_ref_ref_neg",
        0
      ],
      "cfg": 1.0
    },
    "_meta": {
      "title": "1a. Costume photo: Guider (CFG 1 for the distilled model)"
    }
  },
  "painting_noise": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 42
    },
    "_meta": {
      "title": "1a. Costume photo: Keyframe seed"
    }
  },
  "painting_sampler_select": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler"
    },
    "_meta": {
      "title": "1a. Costume photo: Sampler"
    }
  },
  "painting_sigmas": {
    "class_type": "Flux2Scheduler",
    "inputs": {
      "steps": 4,
      "width": 400,
      "height": 656
    },
    "_meta": {
      "title": "1a. Costume photo: 4-step schedule"
    }
  },
  "painting_empty": {
    "class_type": "EmptyFlux2LatentImage",
    "inputs": {
      "width": 400,
      "height": 656,
      "batch_size": 1
    },
    "_meta": {
      "title": "1a. Costume photo: Keyframe canvas"
    }
  },
  "painting_sample": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "painting_noise",
        0
      ],
      "guider": [
        "painting_guider",
        0
      ],
      "sampler": [
        "painting_sampler_select",
        0
      ],
      "sigmas": [
        "painting_sigmas",
        0
      ],
      "latent_image": [
        "painting_empty",
        0
      ]
    },
    "_meta": {
      "title": "1a. Costume photo: Generate keyframe"
    }
  },
  "painting": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "painting_sample",
        0
      ],
      "vae": [
        "klein_vae",
        0
      ]
    },
    "_meta": {
      "title": "1a. Costume photo: Keyframe image"
    }
  },
  "painting_save": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "painting",
        0
      ],
      "filename_prefix": "freefield/painting"
    },
    "_meta": {
      "title": "1a. Costume photo: Save keyframe (also used by the eval)"
    }
  },
