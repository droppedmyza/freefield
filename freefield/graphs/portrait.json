{
  "klein_model": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "flux-2-klein-4b-fp8.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "FLUX.2 klein 4B (Apache-2.0)"
    }
  },
  "klein_te": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen_3_4b_fp8_mixed.safetensors",
      "type": "flux2",
      "device": "default"
    },
    "_meta": {
      "title": "Qwen3-4B text encoder"
    }
  },
  "klein_vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "flux2-vae.safetensors"
    },
    "_meta": {
      "title": "FLUX.2 VAE"
    }
  },
  "keyframe_prompt": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "",
      "clip": [
        "klein_te",
        0
      ]
    },
    "_meta": {
      "title": "Keyframe prompt (what the still should show)"
    }
  },
  "keyframe_negative": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": [
        "keyframe_prompt",
        0
      ]
    },
    "_meta": {
      "title": "Empty negative (CFG 1)"
    }
  },
  "keyframe_guider": {
    "class_type": "CFGGuider",
    "inputs": {
      "model": [
        "klein_model",
        0
      ],
      "positive": [
        "keyframe_prompt",
        0
      ],
      "negative": [
        "keyframe_negative",
        0
      ],
      "cfg": 1.0
    },
    "_meta": {
      "title": "Guider (CFG 1 for the distilled model)"
    }
  },
  "keyframe_noise": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 42
    },
    "_meta": {
      "title": "Keyframe seed"
    }
  },
  "keyframe_sampler_select": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler"
    },
    "_meta": {
      "title": "Sampler"
    }
  },
  "keyframe_sigmas": {
    "class_type": "Flux2Scheduler",
    "inputs": {
      "steps": 4,
      "width": 768,
      "height": 1024
    },
    "_meta": {
      "title": "4-step schedule"
    }
  },
  "keyframe_empty": {
    "class_type": "EmptyFlux2LatentImage",
    "inputs": {
      "width": 768,
      "height": 1024,
      "batch_size": 1
    },
    "_meta": {
      "title": "Keyframe canvas"
    }
  },
  "keyframe_sample": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "keyframe_noise",
        0
      ],
      "guider": [
        "keyframe_guider",
        0
      ],
      "sampler": [
        "keyframe_sampler_select",
        0
      ],
      "sigmas": [
        "keyframe_sigmas",
        0
      ],
      "latent_image": [
        "keyframe_empty",
        0
      ]
    },
    "_meta": {
      "title": "Generate keyframe"
    }
  },
  "keyframe": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "keyframe_sample",
        0
      ],
      "vae": [
        "klein_vae",
        0
      ]
    },
    "_meta": {
      "title": "Keyframe image"
    }
  },
  "keyframe_save": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "keyframe",
        0
      ],
      "filename_prefix": "freefield/keyframe"
    },
    "_meta": {
      "title": "Save keyframe (also used by the eval)"
    }
  }
}
